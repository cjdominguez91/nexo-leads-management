# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (Celery + Channels) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Autenticación: switch de proveedores (pueden estar ambos activos) ──
AUTH_GOOGLE_ENABLED=false
AUTH_LOCAL_ENABLED=true

# Solo requerido si AUTH_GOOGLE_ENABLED=true. Se obtiene gratis creando un
# proyecto en Google Cloud Console > APIs & Services > Credentials > OAuth
# Client ID (tipo "Web application"). No requiere Google Workspace de pago.
GOOGLE_OAUTH_CLIENT_ID=
# Opcional: restringe el login de Google a un dominio corporativo (claim `hd`).
# Déjalo vacío para aceptar cualquier cuenta de Google.
GOOGLE_WORKSPACE_DOMAIN=

# ── Frontend (Vite build-time) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
